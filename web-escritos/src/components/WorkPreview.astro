---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 4);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<section id="projects" class="work-preview section">
  <div class="section-heading">
    <p class="eyebrow">Latest articles</p>
    <h2 id="latest-articles">Selected stories.</h2>
    <a class="text-link" href={withBase('/blog/')}>All articles</a>
  </div>

  {
    posts.length > 0 ? (
      <ol class="work-preview-list">
        {
          posts.map((post, index) => (
            <li class="work-preview-item" style={`--i: ${index}`}>
              <a
                class="work-preview-image"
                href={withBase(`/blog/${post.id}/`)}
                aria-label={post.data.title}
              >
                {post.data.heroImage ? (
                  <Image
                    src={post.data.heroImage}
                    alt=""
                    width={960}
                    height={640}
                    loading="lazy"
                  />
                ) : (
                  <span class="work-preview-placeholder" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                )}
              </a>
              <div class="work-preview-body">
                <p class="meta">
                  <time datetime={post.data.publishDate.toISOString()}>
                    {formatDate(post.data.publishDate)}
                  </time>
                </p>
                <h3>
                  <a class="work-preview-title" href={withBase(`/blog/${post.id}/`)}>
                    {post.data.title}
                    <span class="work-preview-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </h3>
                <p class="work-preview-description">{post.data.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    ) : (
      <div class="empty-state compact">
        <p>Add blog entries under <code>src/content/blog</code> to surface the latest notes here.</p>
      </div>
    )
  }
</section>

<style>
  .work-preview-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 6rem);
  }

  .work-preview-item {
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity 600ms ease calc(var(--i, 0) * 70ms),
      transform 600ms ease calc(var(--i, 0) * 70ms);
  }

  .work-preview-item.is-inview {
    opacity: 1;
    transform: translateY(0);
  }

  a.work-preview-image {
    display: block;
    background-image: none;
  }

  .work-preview-image img,
  .work-preview-placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: var(--hairline);
    background: var(--color-soft);
    clip-path: inset(30% 0 30% 0);
    transition: clip-path 800ms ease;
  }

  .work-preview-item.is-inview .work-preview-image img,
  .work-preview-item.is-inview .work-preview-placeholder {
    clip-path: inset(0 0 0 0);
  }

  .work-preview-placeholder {
    display: grid;
    place-items: center;
    background: var(--color-surface);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .work-preview-body {
    padding-top: calc(var(--baseline) * 0.9);
  }

  .work-preview-body h3 {
    max-width: 22ch;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.15;
    margin-bottom: calc(var(--baseline) * 0.5);
  }

  .work-preview-title {
    display: inline;
    white-space: nowrap;
  }

  .work-preview-arrow {
    display: inline-block;
    margin-left: 0.5rem;
    color: var(--color-accent);
    font-weight: 400;
    transition: transform 180ms ease;
  }

  a.work-preview-title:hover .work-preview-arrow {
    transform: translateX(0.25rem);
  }

  .work-preview-description {
    margin: 0;
    max-width: 52ch;
    color: var(--color-muted);
  }

  @media (min-width: 768px) {
    .work-preview-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(3rem, 8vw, 6rem);
    }

    .work-preview-item:nth-child(even) {
      margin-top: clamp(4rem, 12vw, 9rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-preview-item {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .work-preview-image img,
    .work-preview-placeholder {
      clip-path: inset(0 0 0 0);
      transition: none;
    }
  }
</style>

<script>
  const items = document.querySelectorAll('.work-preview-item');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-inview');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
    );
    items.forEach((item) => observer.observe(item));
  } else {
    items.forEach((item) => item.classList.add('is-inview'));
  }
</script>
