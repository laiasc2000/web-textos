---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import portrait from '../../assets/images/about/portrait.jpg';
---

<BaseLayout title="About" description="About the author behind this Astro Keel site.">
  <section class="page-head section">
    <!--<p class="eyebrow">About</p> -->
    <div class="page-head-inner">
      <div>
        <h1>About</h1>
        <p class="lead">
          Physicist, science journalist and writer.
          <br><span class="accent-text">Contact: laia.serradesanferm@proton.me</span>

        </p>
      </div>
      <figure class="portrait">
        <Image src={portrait} alt="Portrait of Laia Serradesanferm" width={960} height={1200} loading="eager" />
      </figure>
    </div>
  </section>

  <section class="section prose-stack">
      <p>
        I am a science writer and journalist with a background in physics and a particular interest in fundamental science and quantum physics. I hold a degree in Physics from the Universitat Autònoma de Barcelona and a Master's in Quantum Science and Technology from the University of Barcelona. I later completed postgraduate studies in Science Communication and Outreach at the Universidad Autónoma de Madrid, which led me to pursue a career communicating science.
      </p>
      <p>
        I currently work as a Science Writer at the Institute of Photonic Sciences (ICFO) in Castelldefels, where I work closely with scientists to write news highlights and press releases about the latest scientific results of the institute. 
        Alongside my work at ICFO, I am also an independent science journalist. 
      </p>
      <p>
        My work includes news articles, press releases, in-depth features, interviews, and science-inspired stories. I am particularly interested in fundamental science and quantum physics, but I enjoy exploring unfamiliar fields and have also covered topics including electrochemistry, biodiversity, biophysics, and materials science.
      </p>
      <p>
        My writing has appeared in Spanish publications including 20 Minutos, Principia Magazine, Revista Española de Física, Agencia SINC, and Ciència Oberta, as well as international outlets such as Phys.org, SciTech Daily, Quantum News, and Neuroscience News. I am particularly interested in the stories behind scientific discoveries: understanding what has been found, why it matters, and how to accurately communicate it in an appealing way to readers beyond the scientific community.
      </p>
    
  </section>

  <section class="section" aria-label="Experience summary">
    <div class="about-ledger">
      <article>
        <span>01</span>
        <h3>Current focus</h3>
        <p>Science journalism and science communication, especially writing about physics and fundamental science.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Background</h3>
        <p>Physics with a Master's in Quantum Science and Technology. Science Writer at a research center.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Contact</h3>
        <p>If you would like me to cover a science story, send me an email at <span class="accent-text">laia.serradesanferm@proton.me</span>.</p>
      </article>
    </div>
  </section>

  
</BaseLayout>

<style>
  .page-head-inner {
    display: flex;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: flex-start;
    justify-content: space-between;
  }

  .portrait {
    flex-shrink: 0;
    width: clamp(7.5rem, 19.5vw, 13.5rem);
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: var(--hairline);
  }

  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .accent-text {
    color: var(--color-accent);
  }

  @media (max-width: 767px) {
    .page-head-inner {
      flex-direction: column;
    }

    .portrait {
      width: 100%;
      max-width: 16.5rem;
    }
  }
</style>
