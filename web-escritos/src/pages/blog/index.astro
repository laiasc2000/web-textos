---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, LANGUAGES } from '../../content.config';
import { withBase } from '../../lib/url';
import MarkdownText from '../../components/MarkdownText.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const tagCounts = new Map<string, number>();
for (const tag of posts.flatMap((post) => post.data.tags)) {
  tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const allTags = [...tagCounts.keys()].sort(
  (a, b) => (tagCounts.get(b) ?? 0) - (tagCounts.get(a) ?? 0) || a.localeCompare(b),
);
const TAGS_VISIBLE = 5;
const tagOverflow = allTags.length > TAGS_VISIBLE;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<BaseLayout title="Blog" description="Articles including news, features, interviews and dissemination articles.">
  <section class="page-head section">
    <!-- <p class="eyebrow">Articles</p> -->
    <h1>Science articles</h1>
    <p class="lead">
      News, features, interviews and dissemination articles.
    </p>
  </section>

  <section class="section content-index" aria-label="Article posts">
    <div class="index-sidebar">
      <p class="eyebrow">Categories</p>
      <div class="filter-group" data-category-filters>
        <button type="button" class="filter-chip is-active" data-category="">All</button>
        {CATEGORIES.map((category) => (
          <button type="button" class="filter-chip" data-category={category}>{category}</button>
        ))}
      </div>

      <p class="eyebrow">Tags</p>
      <div
        class:list={['filter-group', 'tag-cluster', { 'is-collapsed': tagOverflow }]}
        data-tag-filters
      >
        {allTags.map((tag) => (
          <button type="button" class="filter-chip" data-tag={tag}>{tag}</button>
        ))}
      </div>
      {tagOverflow && (
        <button type="button" class="tag-toggle" data-tag-toggle>
          Show all tags
        </button>
      )}

      <p class="eyebrow">Languages</p>
      <div class="filter-group" data-language-filters>
        <button type="button" class="filter-chip is-active" data-language="">All</button>
        {LANGUAGES.map((language) => (
          <button type="button" class="filter-chip" data-language={language}>{language}</button>
        ))}
      </div>
    </div>

    <div>
      <div class="entry-list">
        {
          posts.map((post) => (
            <article
              class="entry-card"
              data-category={post.data.category}
              data-tags={post.data.tags.join(' ')}
              data-language={post.data.language}
            >
              <div class="entry-meta">
                <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
                <span class="entry-category">{post.data.category}</span>
                <span>{post.data.tags.join(' / ')}</span>
              </div>
              <h2><a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a></h2>
              <MarkdownText content={post.data.description} />
            </article>
          ))
        }
      </div>
      <p class="filter-empty" hidden>No articles match the selected filters.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .filter-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: calc(var(--baseline) * 1.2);
  }

  .filter-chip {
    border: var(--hairline);
    padding: 0.35rem 0.7rem;
    background: var(--color-bg);
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .filter-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .filter-chip.is-active {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: oklch(0.99 0.003 100);
  }

  .tag-cluster.is-collapsed .filter-chip:nth-child(n + 6) {
    display: none;
  }

  .tag-toggle {
    display: block;
    margin-bottom: calc(var(--baseline) * 1.2);
    padding: 0;
    border: none;
    background: none;
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
  }

  .tag-toggle:hover {
    text-decoration: underline;
  }

  .entry-category {
    color: var(--color-accent);
  }

  .filter-empty {
    margin: 0;
    padding: calc(var(--baseline) * 1.5) 0;
    border-top: var(--hairline);
    border-bottom: var(--hairline);
    color: var(--color-muted);
  }
</style>

<script>
  const categoryButtons = Array.from(
    document.querySelectorAll<HTMLElement>('[data-category-filters] [data-category]'),
  );
  const tagButtons = Array.from(
    document.querySelectorAll<HTMLElement>('[data-tag-filters] [data-tag]'),
  );
  const languageButtons = Array.from(
    document.querySelectorAll<HTMLElement>('[data-language-filters] [data-language]'),
  );
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.entry-card'));
  const empty = document.querySelector<HTMLElement>('.filter-empty');
  const tagList = document.querySelector<HTMLElement>('.tag-cluster');
  const tagToggle = document.querySelector<HTMLButtonElement>('[data-tag-toggle]');

  let activeCategory = '';
  let activeLanguage = '';
  const activeTags = new Set<string>();

  if (tagList && tagToggle) {
    tagToggle.addEventListener('click', () => {
      const collapsed = tagList.classList.toggle('is-collapsed');
      tagToggle.textContent = collapsed ? 'Show all tags' : 'Show fewer';
    });
  }

  const apply = () => {
    let visible = 0;
    for (const card of cards) {
      const category = card.dataset.category || '';
      const language = card.dataset.language || '';
      const tags = (card.dataset.tags || '').split(' ').filter(Boolean);
      const matchesCategory = !activeCategory || category === activeCategory;
      const matchesLanguage = !activeLanguage || language === activeLanguage;
      const matchesTags = activeTags.size === 0 || [...activeTags].some((tag) => tags.includes(tag));
      const show = matchesCategory && matchesLanguage && matchesTags;
      card.hidden = !show;
      if (show) visible += 1;
    }
    if (empty) empty.hidden = visible !== 0;
  };

  for (const button of categoryButtons) {
    button.addEventListener('click', () => {
      activeCategory = button.dataset.category ?? '';
      for (const b of categoryButtons) b.classList.toggle('is-active', b === button);
      apply();
    });
  }

  for (const button of tagButtons) {
    button.addEventListener('click', () => {
      const tag = button.dataset.tag ?? '';
      if (activeTags.has(tag)) {
        activeTags.delete(tag);
        button.classList.remove('is-active');
      } else {
        activeTags.add(tag);
        button.classList.add('is-active');
      }
      apply();
    });
  }

  for (const button of languageButtons) {
    button.addEventListener('click', () => {
      activeLanguage = button.dataset.language ?? '';
      for (const b of languageButtons) b.classList.toggle('is-active', b === button);
      apply();
    });
  }
</script>
